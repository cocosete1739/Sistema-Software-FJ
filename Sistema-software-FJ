# Módulo de excepciones personalizadas para el sistema Software FJ
# Permite manejar de forma controlada los errores específicos del negocio.

class SoftwareFJError(Exception):
    """Excepción base para todos los errores controlados de Software FJ."""
    pass

class ClienteInvalidoError(SoftwareFJError):
    """Excepción lanzada cuando los datos del cliente violan las validaciones."""
    pass

class ServicioNoDisponibleError(SoftwareFJError):
    """Excepción lanzada cuando se intenta operar con un servicio inexistente o inactivo."""
    pass

class ReservaInvalidaError(SoftwareFJError):
    """Excepción lanzada ante parámetros incorrectos o fallos en las reservas."""
    pass
