import datetime

def registrar_log(mensaje, tipo="INFO"):
    """
    Registra eventos y errores detallados en un archivo de texto 'software_fj.log',
    incluyendo la fecha y hora exacta del suceso sin detener la aplicación.
    """
    try:
        # Apertura del archivo de logs en modo adjuntar (append) con codificación UTF-8
        with open("software_fj.log", "a", encoding="utf-8") as archivo_log:
            tiempo_actual = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            archivo_log.write(f"[{tiempo_actual}] [{tipo}] {mensaje}\n")
    except Exception as error_escritura:
        print(f"Error crítico al intentar escribir en el archivo de logs: {error_escritura}")
