# Módulo principal de ejecución que simula las 10 operaciones obligatorias (válidas e inválidas)
from modelos import Cliente, ReservaSala, AlquilerEquipo, AsesoriaEspecializada, Reserva
from excepciones import SoftwareFJError
from logger import registrar_log

def ejecutar_simulacion_sistema():
    print("=======================================================")
    print("      INICIO DE SIMULACIÓN - SOFTWARE FJ (FASE 4)      ")
    print("=======================================================\n")

    # Lista con 10 funciones anónimas que representan las 10 operaciones requeridas
    operaciones_simulacion = [
        # Op 1: Registro válido de un cliente
        lambda: Cliente("C-101", "María Rodríguez", "maria.rodriguez@unad.edu.co", "3104567890"),
        
        # Op 2: Registro inválido de cliente (Provocará excepción controlada por correo incorrecto)
        lambda: Cliente("C-102", "Pedro Infante", "correo-sin-arroba.com", "3201234567"),
        
        # Op 3: Creación correcta de un servicio de reserva de sala
        lambda: ReservaSala("S-201", "Auditorio Principal", 60000, 30),
        
        # Op 4: Cálculo de costos con parámetros opcionales y descuentos (Método sobrecargado)
        lambda: ReservaSala("S-201", "Auditorio Principal", 60000, 30).calcular_costo(horas=4, descuento=15000),
        
        # Op 5: Creación correcta de alquiler de equipos tecnológicos
        lambda: AlquilerEquipo("E-301", "Kit de Realidad Virtual", 45000, "Oculus"),
        
        # Op 6: Cálculo de costo de equipo incluyendo un seguro opcional
        lambda: AlquilerEquipo("E-301", "Kit de Realidad Virtual", 45000, "Oculus").calcular_costo(dias=3, seguro_adicional=20000),
        
        # Op 7: Creación correcta de asesoría especializada en arquitectura de software
        lambda: AsesoriaEspecializada("A-401", "Mentoría POO Avanzada", 90000, "Desarrollo de Software"),
        
        # Op 8: Intento de reserva incorrecto (Horas negativas para probar la robustez y bloques try/except)
        lambda: ReservaSala("S-202", "Sala de Juntas", 30000, 8).calcular_costo(horas=-5),
        
        # Op 9: Creación y confirmación exitosa de una reserva completa
        lambda: Reserva("R-501", 
                        Cliente("C-103", "Laura Gómez", "laura@gmail.com", "3159998877"), 
                        AlquilerEquipo("E-302", "Proyector Láser", 25000, "Epson"), 
                        duracion=2).confirmar_reserva(),
        
        # Op 10: Operación fallida simulada por datos nulos o inconsistentes en la creación de servicios
        lambda: AsesoriaEspecializada(None, None, -500, None).calcular_costo(0)
    ]

    # Bucle secuencial para evaluar cada operación utilizando la estructura completa de excepciones
    for indice, operacion in enumerate(operaciones_simulacion, start=1):
        print(f"-------------------------------------------------------")
        print(f" Ejecutando Operación #{indice} de 10...")
        
        try:
            # Intento de ejecución de la operación lógica
            resultado = operacion()
            
        except SoftwareFJError as error_negocio:
            # Manejo estructurado de excepciones de negocio personalizadas
            print(f" -> [CONTROLADO] Error de negocio detectado: {error_negocio}")
            registrar_log(f"Operación #{indice} falló por regla de negocio: {error_negocio}", "ERROR")
            
        except Exception as error_inesperado:
            # Manejo genérico para capturar cualquier otra falla imprevista
            print(f" -> [CRÍTICO] Error inesperado en el sistema: {error_inesperado}")
            registrar_log(f"Operación #{indice} falló por error crítico: {error_inesperado}", "FATAL")
            
        else:
            # Bloque else: Se ejecuta únicamente si todo transcurre sin errores
            print(f" -> [ÉXITO] Operación procesada correctamente. Resultado: {resultado}")
            registrar_log(f"Operación #{indice} ejecutada de forma exitosa.", "INFO")
            
        finally:
            # Bloque finally: Se ejecuta siempre, garantizando la estabilidad continua de la aplicación
            print(f" -> [FINALLY] Estado del sistema: Estable y activo tras la operación #{indice}.")

    print("\n=======================================================")
    print("      SIMULACIÓN FINALIZADA CON ÉXITO Y SIN CAÍDAS     ")
    print("=======================================================")

if __name__ == "__main__":
    ejecutar_simulacion_sistema()
