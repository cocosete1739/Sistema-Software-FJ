from abc import ABC, abstractmethod
from excepciones import ClienteInvalidoError, ReservaInvalidaError

# Clase abstracta general que representa cualquier entidad principal del sistema
class EntidadSistema(ABC):
    def __init__(self, id_entidad):
        self._id_entidad = id_entidad

    @abstractmethod
    def obtener_detalles(self):
        """Método abstracto que deben implementar obligatoriamente las clases hijas."""
        pass


# Clase Cliente con encapsulación estricta y validaciones en propiedades
class Cliente(EntidadSistema):
    def __init__(self, id_entidad, nombre, email, telefono):
        super().__init__(id_entidad)
        self.nombre = nombre
        self.email = email  # Utiliza el setter validado
        self.telefono = telefono

    @property
    def email(self):
        """Devuelve de forma segura el correo electrónico del cliente."""
        return self._email

    @email.setter
    def email(self, valor):
        """Valida estrictamente que el correo contenga '@' y '.' antes de asignarlo."""
        if not valor or "@" not in valor or "." not in valor:
            raise ClienteInvalidoError(f"El correo electrónico ingresado es inválido: '{valor}'.")
        self._email = valor

    def obtener_detalles(self):
        return f"Cliente ID: {self._id_entidad} | Nombre: {self.nombre} | Email: {self._email}"


# Clase abstracta Servicio que establece la base para los servicios de Software FJ
class Servicio(EntidadSistema):
    def __init__(self, id_entidad, nombre_servicio, costo_base):
        super().__init__(id_entidad)
        self.nombre_servicio = nombre_servicio
        self.costo_base = costo_base

    @abstractmethod
    def calcular_costo(self, *args, **kwargs):
        """Método abstracto polimórfico para calcular tarifas según el servicio."""
        pass

    @abstractmethod
    def describir_servicio(self):
        """Método abstracto para detallar las características del servicio."""
        pass


# Servicio Especializado 1: Reserva de Salas (Aplica polimorfismo y sobrecarga de métodos)
class ReservaSala(Servicio):
    def __init__(self, id_entidad, nombre_servicio, costo_base, capacidad):
        super().__init__(id_entidad, nombre_servicio, costo_base)
        self.capacidad = capacidad

    # Método sobrecargado: acepta horas, descuentos opcionales e impuestos parametrizados
    def calcular_costo(self, horas=1, descuento=0.0, impuesto=0.19):
        try:
            if horas <= 0:
                raise ReservaInvalidaError("El número de horas reservadas debe ser mayor a cero.")
            
            subtotal = (self.costo_base * horas) - descuento
            total_final = subtotal + (subtotal * impuesto)
            return max(0.0, total_final)
        except Exception as e:
            # Encadenamiento de excepciones exigido por la guía de actividades
            raise ReservaInvalidaError(f"Fallo en el cálculo de costos de sala: {e}") from e

    def describir_servicio(self):
        return f"[Sala] {self.nombre_servicio} - Capacidad: {self.capacidad} personas"


# Servicio Especializado 2: Alquiler de Equipos
class AlquilerEquipo(Servicio):
    def __init__(self, id_entidad, nombre_servicio, costo_base, marca):
        super().__init__(id_entidad, nombre_servicio, costo_base)
        self.marca = marca

    def calcular_costo(self, dias=1, seguro_adicional=0.0):
        if dias <= 0:
            raise ReservaInvalidaError("Los días de alquiler no pueden ser negativos o cero.")
        return (self.costo_base * dias) + seguro_adicional

    def describir_servicio(self):
        return f"[Equipo] {self.nombre_servicio} - Marca: {self.marca}"


# Servicio Especializado 3: Asesorías Especializadas
class AsesoriaEspecializada(Servicio):
    def __init__(self, id_entidad, nombre_servicio, costo_base, area_especialidad):
        super().__init__(id_entidad, nombre_servicio, costo_base)
        self.area_especialidad = area_especialidad

    def calcular_costo(self, numero_sesiones=1):
        if numero_sesiones <= 0:
            raise ReservaInvalidaError("El número de sesiones de asesoría debe ser mayor a cero.")
        return self.costo_base * numero_sesiones

    def describir_servicio(self):
        return f"[Asesoría] {self.nombre_servicio} - Área: {self.area_especialidad}"


# Clase Reserva que integra cliente, servicio y gestión de estados
class Reserva:
    def __init__(self, id_reserva, cliente, servicio, duracion):
        self.id_reserva = id_reserva
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.estado = "Pendiente"

    def confirmar_reserva(self):
        self.estado = "Confirmada"
        return "Reserva confirmada con éxito."

    def cancelar_reserva(self):
        self.estado = "Cancelada"
        return "La reserva ha sido cancelada."
